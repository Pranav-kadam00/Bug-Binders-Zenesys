# ─── AQURA Frontend Environment ───────────────────────────────────────────────
# Copy this file to .env and fill in the values before running `npm run dev`.
# Never commit .env to version control.

# Base URL of the FastAPI backend.
# During local development the Vite proxy forwards /api/* automatically,
# so you can leave this blank or point it at the backend directly.
VITE_API_BASE_URL=http://localhost:8001
