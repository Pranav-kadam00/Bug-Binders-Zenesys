# ─── AQURA Backend Environment ────────────────────────────────────────────────
# Copy this file to backend/.env and fill in the values before running uvicorn.
# Never commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Get this from: Supabase project → Settings → Database → Connection string
# Use the "URI" format (postgres://...).
# Leave blank to run the backend with in-memory demo data only.
DATABASE_URL=

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong random secret:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── AI provider ───────────────────────────────────────────────────────────────
# Use "mock" to run without an external AI API key.
AI_PROVIDER=mock
AI_API_KEY=

# ── Map / vendor-discovery provider ───────────────────────────────────────────
MAP_PROVIDER=mock
MAP_API_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=mock
