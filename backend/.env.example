# ==========================================
# APPLICATION
# ==========================================
APP_ENV=development
DEBUG=true

# ==========================================
# DATABASE
# ==========================================
# Supabase PostgreSQL connection URI — leave blank for in-memory demo mode
# Get from: Supabase → Settings → Database → Connection string (URI)
DATABASE_URL=

# ==========================================
# AUTHENTICATION
# ==========================================
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# CORS
# ==========================================
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ==========================================
# AQURA CURRENCY
# ==========================================
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN
DEFAULT_GST_RATE=18

# ==========================================
# MAP / LOCATION
# ==========================================
MAP_PROVIDER=mock
MAP_API_KEY=

# ==========================================
# VENDOR DISCOVERY
# ==========================================
DEFAULT_INITIAL_RADIUS_KM=10
DEFAULT_MAX_RADIUS_KM=100
DEFAULT_MIN_VENDOR_RESULTS=5

# ==========================================
# ERP
# ==========================================
# Options: mock | netsuite
ERP_PROVIDER=mock
ERP_SYNC_ENABLED=false

# ==========================================
# NETSUITE
# ==========================================
# Set NETSUITE_INTEGRATION_MODE=sandbox or production when ready.
# Leave all fields blank to run in mock mode (no real API calls).
NETSUITE_INTEGRATION_MODE=mock

NETSUITE_ACCOUNT_ID=
NETSUITE_BASE_URL=

# Options: mock | token_based | oauth2
NETSUITE_AUTH_MODE=mock

# OAuth2 credentials
NETSUITE_CLIENT_ID=
NETSUITE_CLIENT_SECRET=
NETSUITE_ACCESS_TOKEN=
NETSUITE_REFRESH_TOKEN=

# Token-Based Auth (TBA) credentials
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=

# Sync settings
NETSUITE_SYNC_ENABLED=false
NETSUITE_SYNC_INTERVAL_MINUTES=15
NETSUITE_MAX_RETRIES=3

# NetSuite internal currency IDs (account-specific)
NETSUITE_CURRENCY_INR_ID=1
NETSUITE_CURRENCY_USD_ID=2

# ==========================================
# AI
# ==========================================
# Options: mock | openai | gemini
AI_PROVIDER=mock
AI_API_KEY=
